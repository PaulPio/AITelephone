# Client
VITE_API_URL=https://your-public-server.example.com
VITE_SOCKET_URL=https://your-public-server.example.com
VITE_JOIN_URL=https://your-vercel-client.example.com/play

# Server
PORT=4000
CLIENT_ORIGIN=https://your-vercel-client.example.com
ROOM_TTL_SECONDS=21600

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_ASSET_BASE_URL=https://cdn.example.com

# Image-to-image provider
AI_ENDPOINT=
AI_API_KEY=
AI_TIMEOUT_MS=15000
FALLBACK_IMAGE_URL=https://your-server.example.com/fallback-cursed.svg
